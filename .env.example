# Copy to .env (git-ignored). No real secrets belong in this file or in the repo.
# The default setup needs no API keys: LLM runs locally through Ollama.
TTAGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
TTAGENT_LLM_MODEL=qwen2.5:14b-instruct
# Only if you point TTAGENT_LLM_BASE_URL at a hosted API (needs security review first).
# Prefer a secrets manager / macOS Keychain over a plain .env for real keys.
# TTAGENT_LLM_API_KEY=
